        item.Size = UDim2.new(1, 0, 0, 26)
        item.Font = Enum.Font.Gotham
        item.Text = dng.Name
        item.TextColor3 = Color3.fromRGB(212, 212, 216)
        item.TextSize = 11
        item.AutoButtonColor = false
        item.ZIndex = 21
        createButtonAnim(item, Color3.fromRGB(24, 24, 27), Color3.fromRGB(63, 63, 70))
        item.MouseButton1Click:Connect(function()
            selectedDungeon = dng
            selectedDiff = dng.Difficulties[1]
            dungeonBtn.Text = "Map: " .. dng.Name .. " ▼"
            dungeonList.Visible = false
            updateDiffList()
        end)
    end
    selectedDungeon = selectedMode.Dungeons[1]
    dungeonBtn.Text = "Map: " .. selectedDungeon.Name .. " ▼"
end

