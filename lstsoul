toggleButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        dropdownList.Visible = false -- Tutup dropdown saat mulai
        toggleButton.Text = "STOP FARMING"
        TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = colorOn}):Play()
        task.spawn(mainLoop)
    else
        toggleButton.Text = "START FARMING"
        TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = colorOff}):Play()
        statusSub.Text = "Status: Dihentikan"
    end
end)
