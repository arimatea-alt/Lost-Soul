-- ==========================================
-- CUSTOM SMOOTH DRAGGING SYSTEM (BUG FIX)
-- ==========================================
local dragging, dragInput, dragStart, startPos
topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local draggingBubble, dragInputBubble, dragStartBubble, startPosBubble
local isActuallyDraggingBubble = false

minBubble.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingBubble = true
        isActuallyDraggingBubble = false
        dragStartBubble = input.Position
        startPosBubble = minBubble.Position
        
        local con
        con = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingBubble = false
                con:Disconnect()
                if not isActuallyDraggingBubble then
                    mainFrame.Position = minBubble.Position
                    minBubble.Visible = false
                    mainFrame.Visible = true
                end
            end
        end)
    end
end)

minBubble.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInputBubble = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInputBubble and draggingBubble then
        local delta = input.Position - dragStartBubble
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            isActuallyDraggingBubble = true
        end
        if isActuallyDraggingBubble then
            minBubble.Position = UDim2.new(startPosBubble.X.Scale, startPosBubble.X.Offset + delta.X, startPosBubble.Y.Scale, startPosBubble.Y.Offset + delta.Y)
        end
    end
end)

