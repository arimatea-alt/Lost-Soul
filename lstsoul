-- ALUR AWAL (DIJALANKAN SEKALI SAJA)
-- ==========================================
local function alurAwalSetup()
    if not isRunning then return end
    print("[Setup] Memulai pengambilan quest awal...")
    
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

    if humanoidRootPart then
        humanoidRootPart.CFrame = lokasiPertama * CFrame.new(0, 3, 0)
    end
    task.wait(1)
    
    if not isRunning then return end
    triggerNPC("DojoStudent")
    task.wait(1)
    
    if not isRunning then return end
    dialogueEvent:FireServer(unpack({ { Choice = "Sure.." } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "Ancient Argument" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "Start 'Ancient Argument'" } }))
    task.wait(1)
    
    if not isRunning then return end
    local currentCharacter = player.Character or player.CharacterAdded:Wait()
    local currentHRP = currentCharacter:WaitForChild("HumanoidRootPart")
    if currentHRP then
        currentHRP.CFrame = lokasiKedua * CFrame.new(0, 3, 0)
    end
    task.wait(1.5)
    
    if not isRunning then return end
    triggerNPC("Shoichi")
    task.wait(1)
    dungeonQuery:InvokeServer(unpack({ "lobbies" }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Exit = true } }))
    task.wait(0.5)
end

-- ==========================================
-- FUNGSI FARMING TARGET DENGAN AUTO-SPAWN WAIT
-- ==========================================
local function farmSpecificMob(getMobFunction)
    print("⏳ Menunggu target spawn...")
    
    local targetMob = nil
    while isRunning and task.wait(0.2) do
        targetMob = getMobFunction()
        if targetMob and targetMob:FindFirstChild("RootPart") then
            local hum = targetMob:FindFirstChild("Humanoid")
            if not hum or hum.Health > 0 then
                break
            end
        end
    end
    
    if not isRunning then return end
    print("✅ Target ditemukan, mengaktifkan magnet, combat, & spam ultimate!")

    local isTargetActive = true
    
    local magnetConnection
    magnetConnection = RunService.Heartbeat:Connect(function()
        if not isTargetActive or not isRunning then return end
        
        local currentMob = getMobFunction()
        if currentMob then
            local targetRoot = currentMob:FindFirstChild("RootPart")
            local targetHumanoid = currentMob:FindFirstChild("Humanoid")
            
            local currentChar = player.Character
            local currentHRP = currentChar and currentChar:FindFirstChild("HumanoidRootPart")

            if currentHRP and targetRoot and (not targetHumanoid or targetHumanoid.Health > 0) then
                currentHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                currentHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                local posisiTarget = targetRoot.CFrame * CFrame.new(0, 0, 3)
                currentChar:PivotTo(posisiTarget)
            elseif targetHumanoid and targetHumanoid.Health <= 0 then
                isTargetActive = false
            end
        else
            isTargetActive = false
        end
    end)

    task.spawn(function()
        while isTargetActive and isRunning do
            local characterRef = player.Character
            if characterRef and characterRef:FindFirstChild("PlayerHandler") then
                local playerHandler = characterRef.PlayerHandler:FindFirstChild("HandlerEvent")
                if playerHandler then
                    local args = {
                        {
                            Skill = true,
                            AttackType = "Down",
                            Key = "V",
                            MouseData = CFrame.new(67.20719909667969, 1008.887451171875, 5086.59912109375, 1, 0, 0, 0, 1, 0, 0, 0, 1)
                        }
                    }
                    playerHandler:FireServer(unpack(args))
                end
            end
            task.wait(0.2)
        end
    end)

    local lastSkill1Time = 0 
    local lastSkill2Time = 0 
    
    local characterRef = player.Character or player.CharacterAdded:Wait()
    local playerHandler = characterRef:WaitForChild("PlayerHandler"):WaitForChild("HandlerEvent")

    while isTargetActive and isRunning and task.wait() do
        local currentMob = getMobFunction()
        if currentMob and currentMob:FindFirstChild("RootPart") then
            local targetRoot = currentMob.RootPart
            local aimCFrame = targetRoot.CFrame 

            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(2)
            if not isTargetActive or not isRunning then break end

            if tick() - lastSkill1Time >= 10 then
                playerHandler:FireServer(unpack({ { Skill = true, AttackType = "Down", Key = "E", MouseData = aimCFrame } }))
                task.wait(5)
                lastSkill1Time = tick()
            else
                playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
                task.wait(2)
            end
            if not isTargetActive or not isRunning then break end

            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(2)
            if not isTargetActive or not isRunning then break end

            playerHandler:FireServer(unpack({ { CombatAction = true, LightAttack = true, MouseData = aimCFrame } }))
            task.wait(0.2)
            if not isTargetActive or not isRunning then break end

            if tick() - lastSkill2Time >= 15 then
                playerHandler:FireServer(unpack({ { Skill = true, AttackType = "Down", Key = "R", MouseData = aimCFrame } }))
                task.wait(2.5)
                lastSkill2Time = tick()
            else
                playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
                task.wait(2)
            end
            if not isTargetActive or not isRunning then break end

            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(2)
            if not isTargetActive or not isRunning then break end

        else
            isTargetActive = false
        end
    end

    if magnetConnection then
        magnetConnection:Disconnect()
    end
    task.wait(0.3)
end

