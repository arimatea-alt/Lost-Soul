-- FUNGSI UTAMA YANG DI-LOOP
-- ==========================================
local function mainLoop()
    print("=== MEMULAI SCRIPT AUTO-QUEST & DUNGEON ===")
    
    alurAwalSetup()

    while isRunning do
        print("[Loop] Membuat dan Memulai Dungeon Lobby...")
        
        if not isRunning then break end
        lobbyAction:InvokeServer(unpack({ "create", "public", "trial", "AncientWorld", 2, 1 }))
        task.wait(1)
        if not isRunning then break end
        
        lobbyAction:InvokeServer(unpack({ "start" }))
        task.wait(2)
        if not isRunning then break end
        
        dungeonSession:FireServer(unpack({ "Ready", "1787387146_6082" }))
        print("-> Berhasil masuk ke sesi Dungeon!")
        
        task.wait(3)
        if not isRunning then break end
        
        local currentCharacter = player.Character or player.CharacterAdded:Wait()
        local attackTool = player.Backpack:FindFirstChild("Attack")
        if attackTool then
            currentCharacter:WaitForChild("Humanoid"):EquipTool(attackTool)
            print("-> Senjata 'Attack' di-equip!")
        end

        -- 1. KUGHA
        if not isRunning then break end
        print("-> Mencari target 1: Kugha...")
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then
                return workspace.Mobs:FindFirstChild("Kugha")
            end
            return nil
        end)
        if not isRunning then break end
        print("✅ Kugha dikalahkan!")

        -- 2. FLYING XUGO (OPTIONAL)
        if not isRunning then break end
        print("-> Mengecek keberadaan target opsional: FlyingXugo...")
        task.wait(2) -- Memberikan jeda waktu barangkali FlyingXugo sedang spawn
        if workspace:FindFirstChild("Mobs") and workspace.Mobs:FindFirstChild("FlyingXugo") then
            print("-> FlyingXugo ditemukan! Mengalahkan FlyingXugo...")
            farmSpecificMob(function()
                if workspace:FindFirstChild("Mobs") then
                    return workspace.Mobs:FindFirstChild("FlyingXugo")
                end
                return nil
            end)
            if not isRunning then break end
            print("✅ FlyingXugo dikalahkan!")
        else
            print("⏭️ FlyingXugo tidak ada, lanjut ke target berikutnya.")
        end

        -- 3. AGITO
        print("-> Mencari target 3: Agito...")
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then
                return workspace.Mobs:FindFirstChild("Agito")
            end
            return nil
        end)
        if not isRunning then break end
        print("✅ Agito dikalahkan!")

        -- 4. DAGUBA
        print("-> Mencari target 4: Daguba...")
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then
                return workspace.Mobs:FindFirstChild("Daguba")
            end
            return nil
        end)
        if not isRunning then break end
        print("✅ Daguba dikalahkan!")

        print("-> Semua boss selesai! Meng-unequip senjata...")
        local activeChar = player.Character
        if activeChar then
            local equippedTool = activeChar:FindFirstChild("Attack")
            if equippedTool then
                equippedTool.Parent = player.Backpack
                print("-> Senjata dikembalikan ke Backpack.")
            end
        end
        
        print("-> Menunggu 10 detik sebelum kembali ke desa/NPC...")
        for i = 1, 10 do
            if not isRunning then break end
            task.wait(1)
        end
        if not isRunning then break end

        print("-> Teleport ke Koordinat Awal (DojoStudent)...")
        local freshChar = player.Character or player.CharacterAdded:Wait()
        local freshHRP = freshChar:WaitForChild("HumanoidRootPart")
        if freshHRP then
            freshHRP.CFrame = lokasiPertama * CFrame.new(0, 3, 0)
        end
        task.wait(1)
        if not isRunning then break end

        print("-> Menyerahkan quest ke DojoStudent...")
        triggerNPC("DojoStudent")
        task.wait(1)
        if not isRunning then break end
        
        dialogueEvent:FireServer(unpack({ { Choice = "Yes, I've completed it." } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Can I get another quest?" } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Ancient Argument" } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Start 'Ancient Argument'" } }))
        task.wait(1)
        if not isRunning then break end

        print("-> Teleport ke Koordinat Kedua (Shoichi)...")
        if freshHRP then
            freshHRP.CFrame = lokasiKedua * CFrame.new(0, 3, 0)
        end
        task.wait(1.5)
        if not isRunning then break end

        print("-> Berinteraksi dengan Shoichi (Sesi 1)...")
        triggerNPC("Shoichi")
        task.wait(1)
        
        dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Exit = true } }))
        task.wait(1)
        if not isRunning then break end

        print("-> Berinteraksi dengan Shoichi (Sesi 2)...")
        triggerNPC("Shoichi")
        task.wait(1)
        
        dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Exit = true } }))
        task.wait(1.5)

        print("🔄 Siklus selesai! Mengulang kembali dari pembuatan Dungeon Lobby...")
    end
    print("🛑 Script dihentikan oleh pengguna.")
end

