    triggerNPC("DojoStudent")
    task.wait(1)
    
    dialogueEvent:FireServer(unpack({ { Choice = "Yes, I've completed it." } }))
    task.wait(1)
    dialogueEvent:FireServer(unpack({ { Choice = "Can I get another quest?" } }))
    task.wait(1)
    dialogueEvent:FireServer(unpack({ { Choice = "Ancient Argument" } }))
    task.wait(1)
    dialogueEvent:FireServer(unpack({ { Choice = "Start 'Ancient Argument'" } }))
    task.wait(1)

    -- 8. KEMBALI KE LOKASI KEDUA & DIALOG SHOICHI
    print("-> Teleport ke Koordinat Kedua (Shoichi)...")
    if freshHRP then
        freshHRP.CFrame = lokasiKedua * CFrame.new(0, 3, 0)
    end
    task.wait(1.5)

    print("-> Berinteraksi dengan Shoichi (Sesi 1)...")
    triggerNPC("Shoichi")
    task.wait(1)
    
    dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Exit = true } }))
    task.wait(1)

    print("-> Berinteraksi dengan Shoichi (Sesi 2)...")
    triggerNPC("Shoichi")
    task.wait(1)
    
    dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
    task.wait(0.5)
