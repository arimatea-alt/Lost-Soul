toggleButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        toggleButton.Text = "Status: ON [Click]"
        toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Hijau
        -- Jalankan mainLoop di background menggunakan task.spawn agar GUI tidak nge-freeze
        task.spawn(mainLoop)
    else
        toggleButton.Text = "Status: OFF [Click]"
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Merah
        -- Ketika di-OFF-kan, variabel isRunning akan bernilai false, 
        -- dan loop/magnet akan otomatis berhenti dalam beberapa detik berikutnya.
    end
end)
