-- ==========================================
-- FUNGSI COMBAT & MAGNET (UNTUK DUNGEON LAIN)
-- ==========================================
local function farmSpecificMob(getMobFunction, mobName, timeout)
    statusSub.Text = "Status: Scan " .. mobName .. "..."
    local targetMob = nil
    local timeWaited = 0
    local isFound = false

    while isRunning and isAlive() and task.wait(0.2) do
        targetMob = getMobFunction()
        if targetMob and targetMob:FindFirstChild("RootPart") then
            local hum = targetMob:FindFirstChild("Humanoid")
            if not hum or hum.Health > 0 then
                isFound = true
                break
            end
        end
        if timeout then
            timeWaited = timeWaited + 0.2
            if timeWaited >= timeout then
                statusSub.Text = mobName .. " di-Skip!"
                return true
            end
        end
    end
    
    if not isRunning or not isAlive() or not isFound then return false end
    statusSub.Text = "Farming: " .. mobName .. " ⚔️ (" .. selectedCombat.Name .. ")"

    local isTargetActive = true
    local magnetConnection
    magnetConnection = RunService.Heartbeat:Connect(function()
        if not isTargetActive or not isRunning or not isAlive() then return end
        local currentMob = getMobFunction()
        
        if currentMob then
            local targetRoot = currentMob:FindFirstChild("RootPart")
            local targetHumanoid = currentMob:FindFirstChild("Humanoid")
            local currentChar = player.Character
            local currentHRP = currentChar and currentChar:FindFirstChild("HumanoidRootPart")

            if currentHRP and targetRoot and (not targetHumanoid or targetHumanoid.Health > 0) then
                currentHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                currentHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                currentChar:PivotTo(targetRoot.CFrame * CFrame.new(0, 0, 3))
            elseif targetHumanoid and targetHumanoid.Health <= 0 then
                isTargetActive = false
            elseif not targetRoot or not targetRoot.Parent then
                isTargetActive = false
            end
        else
            isTargetActive = false
        end
    end)

    local characterRef = player.Character or player.CharacterAdded:Wait()
    local playerHandler = characterRef:WaitForChild("PlayerHandler"):WaitForChild("HandlerEvent")

    while isTargetActive and isRunning and isAlive() and task.wait() do
        local currentMob = getMobFunction()
        if currentMob and currentMob:FindFirstChild("RootPart") then
            local aimCFrame = currentMob.RootPart.CFrame 
            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(0.12)
        else
            isTargetActive = false
        end
    end

    if magnetConnection then magnetConnection:Disconnect() end
    task.wait(0.3)
    
    if not isAlive() then return false end
    return true
end

-- ==========================================
-- FUNGSI UTAMA YANG DI-LOOP
-- ==========================================
local function mainLoop()
    local needsHenshin = true
    local oreQuestCount = 0   -- Counter quest selesai (ke 6)
    local exchangeSessionCount = 0 -- Counter sesi exchange (ke 3)

    while isRunning do
        -- Cek Kematian / Respawn
        if not isAlive() then
            statusSub.Text = "Status: Menunggu Respawn..."
            player.CharacterAdded:Wait()
            task.wait(2)
            needsHenshin = true
            if not isRunning then break end
        end

        -- 1. AUTO HENSHIN 
        if needsHenshin then
            local successHenshin = doAutoHenshin()
            if not successHenshin then continue end
            if not isRunning then break end
            needsHenshin = false
        end
        
        -- ==========================================
        -- LOGIKA KHUSUS MODE: "FARM ORE"
        -- ==========================================
        if selectedMode.ModeName == "Farm Ore" then
            statusSub.Text = "Status: Mengambil Quest Ore..."
            takeOreQuest()
            if not isAlive() then continue end
            if not isRunning then break end
            
            -- Equip Tool Attack
            local currentCharacter = player.Character or player.CharacterAdded:Wait()
            local attackTool = player.Backpack:FindFirstChild("Attack")
            if attackTool then
                currentCharacter:WaitForChild("Humanoid"):EquipTool(attackTool)
            end
            
            -- Menghitung MiningGoon (Pola bergantian: 1, lalu 2, lalu 1, lalu 2... sampai 12)
            local killedCount = 0
            local addTwoNext = false
            while killedCount < 12 and isRunning and isAlive() do
                statusSub.Text = "Status: Farm MiningGoon (" .. killedCount .. "/12)"
                
                local targetMob = nil
                if workspace:FindFirstChild("Mobs") then
                    local mobsList = workspace.Mobs:GetChildren()
                    for i = 1, #mobsList do
                        local mob = mobsList[i]
                        if mob and mob.Name == "MiningGoon" then
                            local root = mob:FindFirstChild("RootPart")
                            if root then
                                targetMob = mob
                                break
                            end
                        end
                    end
                end
                
                if targetMob and targetMob:FindFirstChild("RootPart") then
                    local targetRoot = targetMob.RootPart
                    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    local playerHandler = player.Character and player.Character:FindFirstChild("PlayerHandler") and player.Character.PlayerHandler:FindFirstChild("HandlerEvent")
                    
                    local connection
                    connection = RunService.Heartbeat:Connect(function()
                        if hrp and targetRoot and targetRoot.Parent then
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            player.Character:PivotTo(targetRoot.CFrame * CFrame.new(0, 0, 3))
                        end
                    end)
                    
                    while targetMob and targetMob.Parent and targetRoot and targetRoot.Parent and isRunning and isAlive() do
                        if playerHandler then
                            local aimCFrame = targetRoot.CFrame
                            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
                        end
                        task.wait(0.12)
                    end
                    
                    if connection then connection:Disconnect() end
                    
                    if addTwoNext then
                        killedCount = killedCount + 2
                        addTwoNext = false
                    else
                        killedCount = killedCount + 1
                        addTwoNext = true
                    end
                    task.wait(0.5)
                else
                    statusSub.Text = "Status: Menunggu MiningGoon Spawn..."
                    task.wait(1)
                end
            end
            
            if not isAlive() then continue end
            if not isRunning then break end
            
            -- Simpan kembali tool attack ke backpack
            local activeChar = player.Character
            if activeChar then
                local equippedTool = activeChar:FindFirstChild("Attack")
                if equippedTool then equippedTool.Parent = player.Backpack end
            end
            
            statusSub.Text = "Status: Menyelesaikan Quest Ore..."
            turnInOreQuest()
            if not isAlive() then continue end
            if not isRunning then break end
            
            -- Menghitung quest selesai (sampai 6 kali)
            oreQuestCount = oreQuestCount + 1
            if oreQuestCount >= 6 then
                statusSub.Text = "Status: Exchange Ore..."
                exchangeOre()
                oreQuestCount = 0
                
                -- Tambahkan hitungan sesi exchange
                exchangeSessionCount = exchangeSessionCount + 1
                
                -- Jika sudah 3x Sesi Exchange -> Lakukan Crafting
                if exchangeSessionCount >= 3 then
                    statusSub.Text = "Status: Crafting Blue Saphire..."
                    craftBlueSapphire()
                    exchangeSessionCount = 0 -- Reset counter
                end
            end
            
            -- Tanpa jeda, langsung looping balik ke quest
            continue
        end

        -- ==========================================
        -- LOGIKA NORMAL UNTUK DUNGEON / YEN FARM / LOST SOUL
        -- ==========================================
        
        if selectedMode.ModeName == "Yen Farm" then
            statusSub.Text = "Status: Mengambil Quest Ryuga..."
            takeYenFarmQuest()
            if not isAlive() then continue end
            if not isRunning then break end
        elseif selectedMode.ModeName == "Lost Soul Farm" then
            takeLostSoulQuest()
            if not isAlive() then continue end
            if not isRunning then break end
        end

        -- BUAT LOBBY & START DUNGEON
        statusSub.Text = "Status: Membuat " .. selectedDungeon.Name .. " (" .. selectedDiff.Name .. ")"
        if not isAlive() then continue end
        if not isRunning then break end
        
        local lobbyArgs = {
            "create",
            "public",
            selectedDungeon.Type,
            selectedDungeon.Map,
            2,
            selectedDiff.Int
        }
        local sessionID = lobbyAction:InvokeServer(unpack(lobbyArgs))
        task.wait(1)
        
        if not isAlive() then continue end
        if not isRunning then break end
        lobbyAction:InvokeServer("start")
        task.wait(2)
        
        if not isAlive() then continue end
        if not isRunning then break end
        if sessionID then
            dungeonSession:FireServer("Ready", sessionID)
        else
            dungeonSession:FireServer("Ready")
        end
        
        task.wait(3)
        if not isAlive() then continue end
        if not isRunning then break end
        
        local currentCharacter = player.Character or player.CharacterAdded:Wait()
        local attackTool = player.Backpack:FindFirstChild("Attack")
        if attackTool then
            currentCharacter:WaitForChild("Humanoid"):EquipTool(attackTool)
        end

        -- LOGIKA MONSTER BERCABANG BERDASARKAN MAP
        local mapStr = selectedDungeon.Map
        local farmSuccess = true
        
        if mapStr == "AncientWorld" then
            farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Kugha") end return nil end, "Kugha")
            if farmSuccess then task.wait(1.5) farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("FlyingXugo") end return nil end, "FlyingXugo", 3) end
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Agito") end return nil end, "Agito") end
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Daguba") end return nil end, "Daguba") end

        elseif mapStr == "Irreplaceable" then
            farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Momotaros") end return nil end, "Momotaros")
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Diend") end return nil end, "Diend (Fase 1)") end
            if farmSuccess then task.wait(1.5) farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Diend") end return nil end, "Diend (Fase 2)") end

        elseif mapStr == "KivaTrial" then
            farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Rook") end return nil end, "Rook")
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Bishop") end return nil end, "Bishop") end
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Kiva") end return nil end, "Kiva") end

        elseif mapStr == "SmartWorld" then
            farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Zyga") end return nil end, "Zyga")
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Elasther") end return nil end, "Elasther") end
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Orca") end return nil end, "Orca") end

        elseif mapStr == "FoundationWorld" then
            farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Double") end return nil end, "Double")
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("FoundationChief") end return nil end, "FoundationChief") end
            if farmSuccess then farmSuccess = farmSpecificMob(function() if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Ethernal") end return nil end, "Ethernal") end

