-- FUNGSI UTAMA YANG DI-LOOP
-- ==========================================
local function mainLoop()
    alurAwalSetup()

    while isRunning do
        statusSub.Text = "Status: Membuat Lobby (" .. selectedDiff.Name .. ")"
        
        if not isRunning then break end
        -- Menggunakan value Int dari Dropdown (1=Easy, 2=Normal, 3=Hard, 4=Extreme)
        lobbyAction:InvokeServer(unpack({ "create", "public", "trial", "AncientWorld", 2, selectedDiff.Int }))
        task.wait(1)
        if not isRunning then break end
        
        lobbyAction:InvokeServer(unpack({ "start" }))
        task.wait(2)
        if not isRunning then break end
        
        -- Menggunakan value Code Ready dari Dropdown
        dungeonSession:FireServer(unpack({ "Ready", selectedDiff.Code }))
        
        task.wait(3)
        if not isRunning then break end
        
        local currentCharacter = player.Character or player.CharacterAdded:Wait()
        local attackTool = player.Backpack:FindFirstChild("Attack")
        if attackTool then
            currentCharacter:WaitForChild("Humanoid"):EquipTool(attackTool)
        end

        -- 1. KUGHA
        if not isRunning then break end
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Kugha") end
            return nil
        end, "Kugha")

        -- 2. FLYING XUGO
        if not isRunning then break end
        task.wait(1.5) 
        if workspace:FindFirstChild("Mobs") and workspace.Mobs:FindFirstChild("FlyingXugo") then
            farmSpecificMob(function()
                if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("FlyingXugo") end
                return nil
            end, "FlyingXugo", 3)
        end

        -- 3. AGITO
        if not isRunning then break end
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Agito") end
            return nil
        end, "Agito")

        -- 4. DAGUBA
        if not isRunning then break end
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then return workspace.Mobs:FindFirstChild("Daguba") end
            return nil
        end, "Daguba")

        -- SELESAI DUNGEON
        statusSub.Text = "Status: Dungeon Selesai!"
        local activeChar = player.Character
        if activeChar then
            local equippedTool = activeChar:FindFirstChild("Attack")
            if equippedTool then equippedTool.Parent = player.Backpack end
        end
        
        for i = 1, 10 do
            if not isRunning then break end
            statusSub.Text = "Status: Istirahat " .. (11 - i) .. "s"
            task.wait(1)
        end
        if not isRunning then break end

        -- 7. TURN IN QUEST
        statusSub.Text = "Status: Turn-in Quest..."
        local freshChar = player.Character or player.CharacterAdded:Wait()
        local freshHRP = freshChar:WaitForChild("HumanoidRootPart")
        if freshHRP then freshHRP.CFrame = lokasiPertama * CFrame.new(0, 3, 0) end
        task.wait(1)
        if not isRunning then break end

        triggerNPC("DojoStudent")
        task.wait(1)
        if not isRunning then break end
        
        dialogueEvent:FireServer(unpack({ { Choice = "Yes, I've completed it." } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Can I get another quest?" } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Ancient Argument" } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Start 'Ancient Argument'" } }))
        task.wait(1)
        if not isRunning then break end

        -- 8. KEMBALI KE SHOICHI
        if freshHRP then freshHRP.CFrame = lokasiKedua * CFrame.new(0, 3, 0) end
        task.wait(1.5)
        if not isRunning then break end

        triggerNPC("Shoichi")
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Exit = true } }))
        task.wait(1)
        if not isRunning then break end

        triggerNPC("Shoichi")
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Exit = true } }))
        task.wait(1.5)
    end
end

