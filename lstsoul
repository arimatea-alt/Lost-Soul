-- ==========================================
local function triggerNPC(npcName)
    local npcFolder = workspace:WaitForChild("NPC", 5)
    if npcFolder and npcFolder:FindFirstChild(npcName) then
        local prompt = npcFolder[npcName]:FindFirstChild("ProximityPrompt")
        if prompt and fireproximityprompt then
            fireproximityprompt(prompt)
            task.wait(0.5)
        end
    end
end

