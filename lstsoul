local function isAlive()
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function doAutoHenshin()
    if not isAlive() then return false end
    statusSub.Text = "Status: Auto Henshin 1..."
    
    local char = player.Character or player.CharacterAdded:Wait()
    local playerHandler = char:WaitForChild("PlayerHandler"):WaitForChild("HandlerEvent")
    
    if playerHandler then
        playerHandler:FireServer(unpack({ { Henshin = true } }))
