-- ==========================================
-- FUNGSI BANTUAN DIALOG & PROXIMITY
-- ==========================================
local function triggerNPC(npcName)
    local npcFolder = workspace:WaitForChild("NPC", 5)
    if npcFolder and npcFolder:FindFirstChild(npcName) then
        local prompt = npcFolder[npcName]:FindFirstChild("ProximityPrompt")
        if prompt and fireproximityprompt then
            fireproximityprompt(prompt)
            task.wait(0.5)
        end
    end
end

-- ==========================================
-- ALUR AWAL (DIJALANKAN SEKALI SAJA)
-- ==========================================
local function alurAwalSetup()
    if not isRunning then return end
    print("[Setup] Memulai pengambilan quest awal...")
    
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

    -- 1. Teleport ke DojoStudent
    if humanoidRootPart then
        humanoidRootPart.CFrame = lokasiPertama * CFrame.new(0, 3, 0)
    end
    task.wait(1)
    
    if not isRunning then return end
    -- 2. Trigger DojoStudent
    triggerNPC("DojoStudent")
    task.wait(1)
    
    if not isRunning then return end
    -- 3. Dialog Ambil Quest Awal
    dialogueEvent:FireServer(unpack({ { Choice = "Sure.." } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "Ancient Argument" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "Start 'Ancient Argument'" } }))
    task.wait(1)
    
    if not isRunning then return end
    -- 4. Teleport ke Shoichi
    local currentCharacter = player.Character or player.CharacterAdded:Wait()
    local currentHRP = currentCharacter:WaitForChild("HumanoidRootPart")
    if currentHRP then
        currentHRP.CFrame = lokasiKedua * CFrame.new(0, 3, 0)
    end
    task.wait(1.5)
    
    if not isRunning then return end
    -- 5. Trigger Shoichi & Query Lobby
    triggerNPC("Shoichi")
    task.wait(1)
    dungeonQuery:InvokeServer(unpack({ "lobbies" }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
    task.wait(0.5)
    dialogueEvent:FireServer(unpack({ { Exit = true } }))
    task.wait(0.5)
end

-- ==========================================
-- FUNGSI FARMING TARGET DENGAN AUTO-SPAWN WAIT
-- ==========================================
local function farmSpecificMob(getMobFunction)
    print("⏳ Menunggu target spawn...")
    
    -- 1. MENUNGGU TARGET MUNCUL DI WORKSPACE
    local targetMob = nil
    while isRunning and task.wait(0.2) do
        targetMob = getMobFunction()
        if targetMob and targetMob:FindFirstChild("RootPart") then
            local hum = targetMob:FindFirstChild("Humanoid")
            if not hum or hum.Health > 0 then
                break
            end
        end
    end
    
    if not isRunning then return end
    print("✅ Target ditemukan, mengaktifkan magnet, combat, & spam ultimate!")

    local isTargetActive = true
    
    -- 2. Sistem Magnet ke RootPart Target secara Real-time
    local magnetConnection
    magnetConnection = RunService.Heartbeat:Connect(function()
        if not isTargetActive or not isRunning then return end
        
        local currentMob = getMobFunction()
        if currentMob then
            local targetRoot = currentMob:FindFirstChild("RootPart")
            local targetHumanoid = currentMob:FindFirstChild("Humanoid")
            
            local currentChar = player.Character
            local currentHRP = currentChar and currentChar:FindFirstChild("HumanoidRootPart")

            if currentHRP and targetRoot and (not targetHumanoid or targetHumanoid.Health > 0) then
                currentHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                currentHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                local posisiTarget = targetRoot.CFrame * CFrame.new(0, 0, 3)
                currentChar:PivotTo(posisiTarget)
            elseif targetHumanoid and targetHumanoid.Health <= 0 then
                isTargetActive = false
            end
        else
            isTargetActive = false
        end
    end)

    -- 3. THREAD TERPISAH: SPAM ULTIMATE TANPA COOLDOWN / ANIMASI
    task.spawn(function()
        while isTargetActive and isRunning do
            local characterRef = player.Character
            if characterRef and characterRef:FindFirstChild("PlayerHandler") then
                local playerHandler = characterRef.PlayerHandler:FindFirstChild("HandlerEvent")
                if playerHandler then
                    local args = {
                        {
                            Skill = true,
                            AttackType = "Down",
                            Key = "V",
                            MouseData = CFrame.new(67.20719909667969, 1008.887451171875, 5086.59912109375, 1, 0, 0, 0, 1, 0, 0, 0, 1)
                        }
                    }
                    playerHandler:FireServer(unpack(args))
                end
            end
            task.wait(0.2)
        end
    end)

    -- 4. Loop Kombo Combat Utama (Heavy & Skill 1/2)
    local lastSkill1Time = 0 
    local lastSkill2Time = 0 
    
    local characterRef = player.Character or player.CharacterAdded:Wait()
    local playerHandler = characterRef:WaitForChild("PlayerHandler"):WaitForChild("HandlerEvent")

    while isTargetActive and isRunning and task.wait() do
        local currentMob = getMobFunction()
        if currentMob and currentMob:FindFirstChild("RootPart") then
            local targetRoot = currentMob.RootPart
            local aimCFrame = targetRoot.CFrame 

            -- Heavy Attack 1
            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(2)
            if not isTargetActive or not isRunning then break end

            -- Skill 1 (Key E - CD 10 Detik)
            if tick() - lastSkill1Time >= 10 then
                playerHandler:FireServer(unpack({ { Skill = true, AttackType = "Down", Key = "E", MouseData = aimCFrame } }))
                task.wait(5)
                lastSkill1Time = tick()
            else
                playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
                task.wait(2)
            end
            if not isTargetActive or not isRunning then break end

            -- Heavy Attack 2
            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(2)
            if not isTargetActive or not isRunning then break end

            -- Basic Attack
            playerHandler:FireServer(unpack({ { CombatAction = true, LightAttack = true, MouseData = aimCFrame } }))
            task.wait(0.2)
            if not isTargetActive or not isRunning then break end

            -- Skill 2 (Key R - CD 15 Detik)
            if tick() - lastSkill2Time >= 15 then
                playerHandler:FireServer(unpack({ { Skill = true, AttackType = "Down", Key = "R", MouseData = aimCFrame } }))
                task.wait(2.5)
                lastSkill2Time = tick()
            else
                playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
                task.wait(2)
            end
            if not isTargetActive or not isRunning then break end

            -- Heavy Attack 3
            playerHandler:FireServer(unpack({ { CombatAction = true, AttackType = "Down", HeavyAttack = true, MouseData = aimCFrame } }))
            task.wait(2)
            if not isTargetActive or not isRunning then break end

        else
            isTargetActive = false
        end
    end

    if magnetConnection then
        magnetConnection:Disconnect()
    end
    task.wait(0.3)
end

-- ==========================================
-- FUNGSI UTAMA YANG DI-LOOP
-- ==========================================
local function mainLoop()
    print("=== MEMULAI SCRIPT AUTO-QUEST & DUNGEON ===")
    
    -- Jalankan setup awal sekali
    alurAwalSetup()

    -- Loop Utama Berkelanjutan
    while isRunning do
        print("[Loop] Membuat dan Memulai Dungeon Lobby...")
        
        if not isRunning then break end
        -- 1. Buat & Start Lobby
        lobbyAction:InvokeServer(unpack({ "create", "public", "trial", "AncientWorld", 2, 1 }))
        task.wait(1)
        if not isRunning then break end
        
        lobbyAction:InvokeServer(unpack({ "start" }))
        task.wait(2)
        if not isRunning then break end
        
        dungeonSession:FireServer(unpack({ "Ready", "1787387146_6082" }))
        print("-> Berhasil masuk ke sesi Dungeon!")
        
        -- 2. Tunggu load & Equip Senjata
        task.wait(3)
        if not isRunning then break end
        
        local currentCharacter = player.Character or player.CharacterAdded:Wait()
        local attackTool = player.Backpack:FindFirstChild("Attack")
        if attackTool then
            currentCharacter:WaitForChild("Humanoid"):EquipTool(attackTool)
            print("-> Senjata 'Attack' di-equip!")
        end

        -- 3. FARM TARGET 1: Kugha
        if not isRunning then break end
        print("-> Mencari target 1: Kugha...")
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then
                return workspace.Mobs:FindFirstChild("Kugha")
            end
            return nil
        end)
        if not isRunning then break end
        print("✅ Kugha dikalahkan!")

        -- 4. FARM TARGET 2: Agito
        print("-> Mencari target 2: Agito...")
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then
                return workspace.Mobs:FindFirstChild("Agito")
            end
            return nil
        end)
        if not isRunning then break end
        print("✅ Agito dikalahkan!")

        -- 5. FARM TARGET 3: Daguba
        print("-> Mencari target 3: Daguba...")
        farmSpecificMob(function()
            if workspace:FindFirstChild("Mobs") then
                return workspace.Mobs:FindFirstChild("Daguba")
            end
            return nil
        end)
        if not isRunning then break end
        print("✅ Daguba dikalahkan!")

        -- 6. SELESAI: Matikan Combat (Unequip senjata ke Backpack)
        print("-> Semua boss selesai! Meng-unequip senjata...")
        local activeChar = player.Character
        if activeChar then
            local equippedTool = activeChar:FindFirstChild("Attack")
            if equippedTool then
                equippedTool.Parent = player.Backpack
                print("-> Senjata dikembalikan ke Backpack.")
            end
        end
        
        print("-> Menunggu 10 detik sebelum kembali ke desa/NPC...")
        for i = 1, 10 do
            if not isRunning then break end
            task.wait(1)
        end
        if not isRunning then break end

        -- 7. KEMBALI KE LOKASI AWAL & SELESAIKAN QUEST (DojoStudent)
        print("-> Teleport ke Koordinat Awal (DojoStudent)...")
        local freshChar = player.Character or player.CharacterAdded:Wait()
        local freshHRP = freshChar:WaitForChild("HumanoidRootPart")
        if freshHRP then
            freshHRP.CFrame = lokasiPertama * CFrame.new(0, 3, 0)
        end
        task.wait(1)
        if not isRunning then break end

        print("-> Menyerahkan quest ke DojoStudent...")
        triggerNPC("DojoStudent")
        task.wait(1)
        if not isRunning then break end
        
        dialogueEvent:FireServer(unpack({ { Choice = "Yes, I've completed it." } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Can I get another quest?" } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Ancient Argument" } }))
        task.wait(1)
        dialogueEvent:FireServer(unpack({ { Choice = "Start 'Ancient Argument'" } }))
        task.wait(1)
        if not isRunning then break end

        -- 8. KEMBALI KE LOKASI KEDUA & DIALOG SHOICHI
        print("-> Teleport ke Koordinat Kedua (Shoichi)...")
        if freshHRP then
            freshHRP.CFrame = lokasiKedua * CFrame.new(0, 3, 0)
        end
        task.wait(1.5)
        if not isRunning then break end

        print("-> Berinteraksi dengan Shoichi (Sesi 1)...")
        triggerNPC("Shoichi")
        task.wait(1)
        
        dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Exit = true } }))
        task.wait(1)
        if not isRunning then break end

        print("-> Berinteraksi dengan Shoichi (Sesi 2)...")
        triggerNPC("Shoichi")
        task.wait(1)
        
        dialogueEvent:FireServer(unpack({ { Choice = "[ Challenge ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Choice = "[ Quest ]" } }))
        task.wait(0.5)
        dialogueEvent:FireServer(unpack({ { Exit = true } }))
        task.wait(1.5)

        print("🔄 Siklus selesai! Mengulang kembali dari pembuatan Dungeon Lobby...")
    end
    print("🛑 Script dihentikan oleh pengguna.")
end

